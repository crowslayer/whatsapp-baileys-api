{
  "name": "whatsapp-baileys-api",
  "version": "1.4.0",
  "description": "WhatsApp Multi-Instance API with Baileys",
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "whatsapp-rust-bridge": "0.5.5"
    }
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json -f -fe .js && pnpm run build:di",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "validate": "pnpm run type-check && pnpm run lint && pnpm run format:check",
    "build:di": "copyfiles -u 1 \"src/**/*.{json,yaml,html,png}\" dist/",
    "seed:flows": "tsx watch ./scripts/seed_flows.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/integration",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "api",
    "nodejs"
  ],
  "author": "Alexander Herrera <crowslayer@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@cacheable/node-cache": "^3.0.0",
    "@hapi/boom": "^10.0.1",
    "@rolldown/binding-win32-x64-msvc": "^1.0.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.13.4",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ejs": "^4.0.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.41",
    "mongoose": "^8.22.1",
    "multer": "^2.0.2",
    "node-dependency-injection": "^3.2.6",
    "pino": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@express-rate-limit/tsconfig": "^1.0.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.32",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.1.5",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-changelog-writer": "^9.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^3.0.6",
    "husky": "^9.1.7",
    "mongodb-memory-server": "^11.0.0",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.9",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
