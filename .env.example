# Copiar a .env y ajustar valores (no commitear .env con secretos reales).
# ==================================
# APPLICATION CONFIGURATION
# ==================================
NODE_ENV=development
PORT=3333
API_PATH=api
API_VERSION=v1
APP_URL=http://localhost:3333

# ==================================
# DATABASE CONFIGURATION
# ==================================
DB_TYPE=mongoose
DB_ENABLED=true
DB_URI=mongodb://localhost:27017/whatsapp-api
DB_OPTIONS_MIN_POOL_SIZE = 5
DB_OPTIONS_MAX_POOL_SIZE = 20
# ==================================
# SECURITY CONFIGURATION
# ==================================
ACCEPTED_ORIGINS = 'http://localhost:4200, http://localhost:3000, http://localhost:4201'
SECURITY_TYPE = jwt
JWT_SECRET =replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES = 1d
JWT_REFRESH_EXPIRES = 7d
PROTECT_ROUTES= false
ENABLED_RATE_LIMITS = true
TOKEN= RANDOM_STRING_O_PERM
COOKIE_NAME = 'cookieSession'
COOKIE_MAXAGE = 60000
COOKIE_HTTP_ONLY = true
COOKIE_SECURE = false
COOKE_SAME_SITE = 'strict'
# ==================================
# lOGGER CONFIGURATION
# ==================================
LOGGER_INSTANCE = 'pino'
LOGGER_LEVEL = 'info'
PINO_LOG_LEVEL = 'info'
TODAY_DATE=$(date +%Y-%m-%d)
#####################################
# WEBHOOKS
#####################################
WEBHOOK_ENABLED=true
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_ALLOWED_PROTOCOLS=https
WEBHOOK_ALLOWED_PORTS=443,8443
WEBHOOK_ALLOWED_HOSTS=discord.com,hooks.slack.com,*.empresa.com
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_SIGN_PAYLOAD=true
WEBHOOK_SIGNATURE_ALGORITHM=sha256
WEBHOOK_USER_AGENT=ApiRestWhatsAPI/2.0
WEBHOOK_CIRCUIT_BREAKER_FAILURE_THRESHOLD = 5
WEBHOOK_CIRCUIT_BREAKER_SUCCESS_THRESHOLD = 2
WEBHOOK_CIRCUIT_BREAKER_TIMEOUT = 30000
WEBHOOK_MAX_BODY_LENGTH=2
WEBHOOK_MAX_CONTENT_LENGTH=5
WEBHOOK_BLOCK_PRIVATE_NETWORKS=true
WEBHOOK_BLOCK_LOOP_BACK=true
WEBHOOK_BLOCK_LINK_LOCAL=true
WEBHOOK_BLOCK_MULTICAST=true
WEBHOOK_BLOCK_RESERVED=true